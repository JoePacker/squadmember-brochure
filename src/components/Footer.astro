		</svg>
		squadmember
	</div>
	<nav class="links" aria-label="Footer">
		{links.map((link) => (
			<a href={link.href}>{link.label}</a>
		))}
	</nav>
	<div class="copy">&copy; {year} SquadMember &middot; squadmember.com</div>
</footer>

<style>
	.footer {
		background: var(--forest-darker);
		padding: 48px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 20px;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: system-ui, sans-serif;
		font-size: 18px;
		font-weight: 500;
		letter-spacing: -0.2px;
		color: var(--cream);
	}

	.logo-mark {
		height: 22px;
		width: auto;
		fill: var(--green-lighter);
	}

	.links {
		display: flex;
		gap: 28px;
		flex-wrap: wrap;
	}

	.links a {
		color: var(--muted);
		font-size: 13.5px;
	}

	.links a:hover {
		color: var(--cream-dim);
	}

	.copy {
		color: var(--muted-dark);
		font-size: 13px;
	}

	@media (max-width: 720px) {
		.footer {
			padding: 32px 24px;
			justify-content: center;
			text-align: center;
		}
	}
</style>
