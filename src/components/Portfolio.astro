---
const clubs = [
	{ name: 'Cwmavon RFC', location: 'Port Talbot, Wales', tier: 'CMS' },
	{ name: 'Bonymaen RFC', location: 'Swansea, Wales', tier: 'Built to Last' },
	{ name: 'Tondu RFC', location: 'Bridgend, Wales', tier: 'CMS + Membership' },
	{ name: 'Nantyffyllon RFC', location: 'Maesteg, Wales', tier: 'CMS' },
];
---

<section id="work" class="portfolio">
	<div class="heading">
		<div class="eyebrow">Our work</div>
		<h2>Recent clubs</h2>
	</div>
	<div class="grid">
		{clubs.map((club) => (
			<div class="card">
				<div class="thumb" aria-hidden="true">
					<span>{club.name}</span>
				</div>
				<div class="details">
					<div>
						<div class="name">{club.name}</div>
						<div class="location">{club.location}</div>
					</div>
					<div class="tier">{club.tier}</div>
				</div>
			</div>
		))}
	</div>
</section>

<style>
	.portfolio {
		background: var(--forest);
		padding: 120px 48px;
	}

	.heading {
		text-align: center;
		margin-bottom: 64px;
	}

	.eyebrow {
		color: var(--green-light);
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 3px;
		text-transform: uppercase;
		margin-bottom: 14px;
	}

	h2 {
		font-family: var(--font-oswald);
		text-transform: uppercase;
		font-size: 54px;
		letter-spacing: 0.5px;
		margin: 0;
		color: var(--cream);
	}

	.grid {
		max-width: 1180px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 32px;
	}

	.card {
		background: var(--forest-light);
		border-radius: 4px;
		overflow: hidden;
		border: 1px solid rgba(244, 239, 227, 0.08);
	}

	.thumb {
		width: 100%;
		height: 280px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, rgba(200, 118, 63, 0.22), rgba(22, 36, 26, 0.4));
		border-bottom: 1px solid rgba(244, 239, 227, 0.08);
	}

	.thumb span {
		font-family: var(--font-oswald);
		text-transform: uppercase;
		font-size: 26px;
		letter-spacing: 1px;
		color: rgba(244, 239, 227, 0.55);
	}

	.details {
		padding: 22px 26px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.name {
		color: var(--cream);
		font-weight: 700;
		font-size: 17px;
	}

	.location {
		color: var(--muted);
		font-size: 13.5px;
		margin-top: 3px;
	}

	.tier {
		color: var(--green-light);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		border: 1px solid var(--green-light);
		border-radius: 999px;
		padding: 6px 14px;
		white-space: nowrap;
	}

	@media (max-width: 860px) {
		.portfolio {
			padding: 80px 24px;
		}

		.grid {
			grid-template-columns: 1fr;
		}

		h2 {
			font-size: 42px;
		}

		.details {
			flex-direction: column;
			align-items: flex-start;
			gap: 12px;
		}
	}
</style>
